{
  "name": "image-compare",
  "private": true,
  "version": "1.3.0-team.0",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "deps": "node scripts/install-deps.mjs",
    "dev:renderer": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "ui": "vite --host 127.0.0.1 --open /ui-kit.html",
    "ui:shots": "node scripts/capture-ui.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "check:ui": "node scripts/check-ui-conventions.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:ui && npm run test && npm run build",
    "check:all": "npm run check && npm run e2e && npm run smoke:electron",
    "audit:prod": "npm audit --omit=dev",
    "smoke:electron": "node scripts/electron-smoke.cjs",
    "smoke:packaged": "node scripts/electron-smoke.cjs --packaged",
    "preview": "vite preview",
    "icons": "node src/generate-icons.mjs",
    "electron:build": "npm run electron:build:win",
    "electron:build:win": "npm run build && npm run icons && electron-builder --win nsis --x64 --publish never",
    "electron:build:mac": "npm run build && npm run icons && electron-builder --mac dmg zip --arm64 --publish never"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "5.0.0",
    "concurrently": "10.0.5",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.0.1",
    "oxlint": "1.80.0",
    "playwright": "1.65.1",
    "png-to-ico": "3.0.2",
    "prettier": "3.10.1",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wait-on": "9.1.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  },
  "description": "图片对比工具",
  "author": "信",
  "build": {
    "appId": "com.imagecompare.app",
    "productName": "图片对比工具",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-renderer/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "artifactName": "Image-Compare-${version}-Windows-${arch}-Setup.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.photography",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "Image-Compare-${version}-macOS-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "图片对比工具 ${version}",
      "icon": "build/icon.icns",
      "backgroundColor": "#181818",
      "window": {
        "width": 540,
        "height": 440
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 340,
          "type": "file",
          "path": "MACOS_INSTALL.txt"
        }
      ]
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
